{
  "name": "@vitest/istanbul-report-html-modern",
  "version": "1.0.1",
  "description": "Modern Istanbul HTML coverage report: Preact UI + single-file HTML page",
  "keywords": [
    "coverage",
    "html",
    "istanbul",
    "preact",
    "report",
    "vitest"
  ],
  "homepage": "https://vitest.dev",
  "bugs": {
    "url": "https://github.com/vitest-dev/vitest/issues"
  },
  "license": "MIT",
  "author": "Travis Zhang<https://github.com/travzhang>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitest-dev/istanbuljs.git",
    "directory": "packages/istanbul-report-html-modern"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:page",
    "build:lib": "tsdown",
    "build:page": "vite build",
    "dev": "vite",
    "play": "vite --config vite.config.playground.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-preact": "catalog:",
    "picomatch": "catalog:"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/theme-one-dark": "catalog:",
    "@codemirror/view": "catalog:",
    "@preact/preset-vite": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/istanbul-lib-report": "workspace:*",
    "preact": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-singlefile": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.0",
    "preact": "^10.0.0"
  }
}
